TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=            # optional stable namespace; otherwise derived from the token prefix
TELEGRAM_INBOX_ENABLED=false # enable only after migration 0009 is verified
TELEGRAM_OUTBOX_ENABLED=false # requires inbox=true, verified migration 0010, and an active outbox worker
TELEGRAM_OUTBOX_WORKER_ENABLED=false # requires inbox=true, outbox=true, verified migration 0010, and CRON/Turso/Telegram credentials
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=HermesFinanceAssistBot
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_CHAT_ID=           # your personal chat_id for proactive alerts (get it from @userinfobot)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Runtime isolation controls. Omitting them preserves legacy behavior.
# Accepted: live (default) or stub. Unknown present values fail closed.
AI_MODE=live
OCR_MODE=live
# Gates only proactive Telegram/Web Push. Direct authenticated Telegram replies remain enabled.
# Accepted: true (default) or false. Unknown present values fail closed.
NOTIFICATIONS_ENABLED=true
# Missing preserves hermes_session. Beta/staging must use a distinct value.
SESSION_COOKIE_NAME=hermes_session
CRON_SECRET=
WEB_ACCESS_TOKEN=
SESSION_SECRET=
OCR_SPACE_API_KEY=         # Free: https://ocr.space/ocrapi (25k req/month)
# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
